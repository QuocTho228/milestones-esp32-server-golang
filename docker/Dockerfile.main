# Giai đoạn build (chỉ hỗ trợ kiến trúc amd64/x64)
# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 golang:1.24.4 AS builder

# Thiết lập biến môi trường để cài đặt ở chế độ không tương tác (non-interactive)
ENV DEBIAN_FRONTEND=noninteractive

# Cài đặt các dependency cần thiết để build
RUN apt-get update && apt-get install -y \
    libopus-dev \
    libopusfile-dev \
    pkg-config \
    libc++-dev \
    libc++abi-dev \
    g++

# Sao chép tệp thư viện onnxruntime (chỉ x64)
COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/

# Cài đặt ONNX Runtime (kiến trúc x64)
RUN echo "Installing ONNX Runtime for x64 architecture" && \
    cd /tmp && \
    if [ ! -f "onnxruntime-linux-x64-1.21.0.tgz" ]; then \
        echo "Error: ONNX Runtime file not found!" && \
        ls -la /tmp/*.tgz 2>/dev/null || echo "No .tgz files found" && \
        exit 1; \
    fi && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz || (echo "Failed to extract ONNX Runtime" && exit 1) && \
    ONNX_DIR=$(ls -d onnxruntime-linux-x64-*/ 2>/dev/null | head -n1) && \
    if [ -z "${ONNX_DIR}" ]; then \
        echo "Error: Failed to find extracted ONNX Runtime directory" && \
        ls -la /tmp/ && \
        exit 1; \
    fi && \
    echo "Found ONNX Runtime directory: ${ONNX_DIR}" && \
    mkdir -p /usr/local/include/onnxruntime && \
    if [ ! -d "${ONNX_DIR}include" ]; then \
        echo "Error: ${ONNX_DIR}include directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}include/* /usr/local/include/onnxruntime/ && \
    if [ ! -d "${ONNX_DIR}lib" ]; then \
        echo "Error: ${ONNX_DIR}lib directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}lib/* /usr/local/lib/ && \
    rm -rf /tmp/onnxruntime* && \
    (ldconfig 2>&1 || echo "Warning: ldconfig failed, but continuing...")

# Thiết lập biến môi trường cho Go
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime" 
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime"
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=1

# Tạo thư mục làm việc và sao chép mã nguồn
WORKDIR /app
# Sao chép thư mục lib trước (chứa header và thư viện của ten-vad, cần thiết khi biên dịch cgo)
COPY lib ./lib
COPY . .

# Kiểm tra nội dung submodule asr_server đã được đưa vào build context (CI cần checkout với submodules: recursive)
RUN test -f asr_server/server/setup.go || (echo "ERROR: Thiếu nội dung submodule asr_server, build context không có package voice_server/server. CI cần đảm bảo checkout với submodules: recursive." && exit 1)

# Tải các module Go
RUN go mod tidy

# Thiết lập đường dẫn thư viện liên kết CGO (dùng cho ten-vad)
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime -L/app/lib/ten-vad/lib/Linux/x64"
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime -I/app/lib/ten-vad/include"

# Build chương trình chính
RUN go build -o /app/milestones_server ./cmd/server/

# Giai đoạn chạy (chỉ hỗ trợ kiến trúc amd64/x64)
FROM --platform=linux/amd64 ubuntu:22.04

# Thiết lập biến môi trường để cài đặt ở chế độ không tương tác (non-interactive)
ENV DEBIAN_FRONTEND=noninteractive

# Cài đặt các dependency thời gian chạy (cài đặt tối giản)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopus0 \
    libopusfile0 \
    libc++1 \
    libc++abi1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Sao chép tệp thư viện onnxruntime (chỉ x64)
COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/

# Cài đặt runtime của ONNX Runtime (kiến trúc x64)
RUN echo "Installing ONNX Runtime for x64 architecture" && \
    cd /tmp && \
    if [ ! -f "onnxruntime-linux-x64-1.21.0.tgz" ]; then \
        echo "Error: ONNX Runtime file not found!" && \
        ls -la /tmp/*.tgz 2>/dev/null || echo "No .tgz files found" && \
        exit 1; \
    fi && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz || (echo "Failed to extract ONNX Runtime" && exit 1) && \
    ONNX_DIR=$(ls -d onnxruntime-linux-x64-*/ 2>/dev/null | head -n1) && \
    if [ -z "${ONNX_DIR}" ]; then \
        echo "Error: Failed to find extracted ONNX Runtime directory" && \
        ls -la /tmp/ && \
        exit 1; \
    fi && \
    echo "Found ONNX Runtime directory: ${ONNX_DIR}" && \
    mkdir -p /usr/local/include/onnxruntime && \
    if [ ! -d "${ONNX_DIR}include" ]; then \
        echo "Error: ${ONNX_DIR}include directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}include/* /usr/local/include/onnxruntime/ && \
    if [ ! -d "${ONNX_DIR}lib" ]; then \
        echo "Error: ${ONNX_DIR}lib directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}lib/* /usr/local/lib/ && \
    rm -rf /tmp/onnxruntime* && \
    (ldconfig 2>&1 || echo "Warning: ldconfig failed, but continuing...")

# Thiết lập biến môi trường cho ONNX Runtime
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime" 
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime"

# Thiết lập thư mục làm việc
WORKDIR /workspace

# Sao chép tệp nhị phân đã biên dịch từ giai đoạn build
COPY --from=builder /app/milestones_server /workspace/bin/milestones_server
# Sao chép thư mục lib (chứa thư viện runtime của ten-vad)
COPY --from=builder /app/lib /workspace/lib

# Tạo các thư mục cần thiết
RUN mkdir -p /workspace/logs /workspace/config

# Thiết lập đường dẫn thư viện runtime (dùng cho ten-vad)
ENV LD_LIBRARY_PATH=/workspace/lib:/workspace/lib/ten-vad/lib/Linux/x64

# Mở các cổng: http/websocket:8989, udp:8990, mqtt: 1883,2883,8883
EXPOSE 8989 8990 1883 2883 8883

# Lệnh khởi động
CMD ["bin/milestones_server", "-c", "config/config.yaml"]