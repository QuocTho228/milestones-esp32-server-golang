# Giai đoạn build (build stage)
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Cài đặt các dependency hệ thống cần thiết
RUN apk add --no-cache git ca-certificates tzdata

# Sao chép các tệp go mod
COPY manager/backend/go.mod manager/backend/go.sum ./

# Sao chép mã nguồn
COPY manager/backend/ .

RUN go mod tidy

# Build ứng dụng
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main .

# Giai đoạn chạy (runtime stage)
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /root/

# Sao chép tệp nhị phân từ giai đoạn build
COPY --from=builder /app/main .
COPY --from=builder /app/config ./config

# Thiết lập múi giờ
ENV TZ=Asia/Shanghai

EXPOSE 8080

CMD ["./main"]