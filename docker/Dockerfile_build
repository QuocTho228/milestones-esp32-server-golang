# Sử dụng Ubuntu image chính thức làm base image
FROM hackers365/milestones_golang_build:0.1 AS builder

WORKDIR /app
COPY . .
RUN go build -o /app/milestones_server /app/cmd/server/  # Biên dịch tạo file thực thi (binary)

FROM ubuntu:22.04

# Thiết lập biến môi trường cài đặt không tương tác (non-interactive)
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends libopus0 libopusfile-dev libc++1 libc++abi1 && rm -rf /var/lib/apt/lists/*

COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/
RUN cd /tmp && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz && \
    mkdir -p /usr/local/include/onnxruntime && \
    cp -r onnxruntime-linux-x64-1.21.0/include/* /usr/local/include/onnxruntime/ && \
    cp -r onnxruntime-linux-x64-1.21.0/lib/* /usr/local/lib/ && \
    rm -rf onnxruntime-linux-x64-1.21.0* && \
    ldconfig
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime" 
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime"

# Thiết lập thư mục làm việc
WORKDIR /workspace

# Chỉ copy file binary đã biên dịch từ build stage (không mang theo source code và dependency biên dịch)
COPY --from=builder /app/milestones_server /workspace/bin/milestones_server
# Copy thư mục lib từ build stage (chứa thư viện runtime ten-vad)
COPY --from=builder /app/lib /workspace/lib

RUN mkdir -p /workspace/logs /workspace/config

# Thiết lập đường dẫn thư viện runtime (dùng cho ten-vad)
ENV LD_LIBRARY_PATH=/workspace/lib:/workspace/lib/ten-vad/lib/Linux/x64 

# Mở cổng, http/websocket:8989, udp:8990  mqtt: 1883,2883,8883, 
EXPOSE 8989 8990 1883 2883 8883

# Lệnh khởi động
CMD ["bin/milestones_server", "-c", "config/config.yaml"]